NODE_ENV=development

# Optional: hosted PostgreSQL connection string; takes precedence over DB_*.
# Keep Neon's SSL parameters from its connection dialog.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=skillsync

JWT_SECRET=change-me

# Percentage SkillSync keeps from each payment (default 10).
PLATFORM_FEE_PERCENT=10
# Days the customer has to release or report a problem after the job is marked
# done, and how long a reported problem waits for the freelancer before the
# payment is released automatically.
PAYMENT_REVIEW_DAYS=3
PAYMENT_DISPUTE_DAYS=14
# Optional: lets a scheduler call GET /payments/auto-release.
CRON_SECRET=
